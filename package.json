{
  "name": "afkllm",
  "version": "0.3.0-20260825-alpha",
  "description": "Local AI code editor powered by llama.cpp",
  "main": "./out/main/index.js",
  "author": "0xQ71 <https://github.com/0xQ71>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xQ71/AFKLLM.git"
  },
  "bugs": {
    "url": "https://github.com/0xQ71/AFKLLM/issues"
  },
  "homepage": "https://github.com/0xQ71/AFKLLM#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:smoke": "tsx --test scripts/agent-smoke.test.ts scripts/git-smoke.test.ts scripts/shell-smoke.test.ts scripts/diagnostics-smoke.test.ts scripts/web-search-smoke.test.ts scripts/mcp-checkpoint-smoke.test.ts scripts/mcp-live-smoke.test.ts scripts/apply-patch-smoke.test.ts scripts/context-index-smoke.test.ts scripts/editor-ide-smoke.test.ts scripts/telemetry-smoke.test.ts scripts/shell-layout-smoke.test.ts scripts/composer-activity-smoke.test.ts scripts/acceptance-gate-smoke.test.ts scripts/translate-ru-smoke.test.ts scripts/llama-runtime-smoke.test.ts scripts/write-file-smoke.test.ts scripts/stack-detect.test.ts",
    "test:git": "tsx --test scripts/git-smoke.test.ts",
    "dist": "npm run build && electron-builder --win --config",
    "dist:dir": "npm run build && electron-builder --win --dir --config",
    "dist:publish": "npm run build && electron-builder --win --config --publish always",
    "verify:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installer.ps1",
    "build:win": "npm run dist",
    "licenses:third-party": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.5",
    "@react-symbols/icons": "^1.4.1",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.1",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "monaco-editor": "^0.52.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "vite": "^6.2.2"
  }
}
